{
  "name": "rma-kinetics-app",
  "version": "0.1.0-beta.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "wasm:build": "cd src-wasm && wasm-pack build --target web --out-dir ../src/lib/backend/wasm-pkg",
    "wasm:dev": "cd src-wasm && wasm-pack build --target web --dev --out-dir ../src/lib/backend/wasm-pkg",
    "dev": "pnpm wasm:dev && vite dev",
    "build": "pnpm wasm:build && vite build",
    "build:tauri": "node scripts/copy-wasm-stub.js && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@internationalized/date": "^3.10.0",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
