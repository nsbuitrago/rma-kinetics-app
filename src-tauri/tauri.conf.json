{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RMA Kinetics Simulator",
  "version": "0.1.0",
  "identifier": "com.rma-kinetics-gui.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RMA Kinetics Simulator",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4REM1RDM0M0E4RTIyRDUKUldUVklvNDZORjNjV01YdmZKZzQvcDl5cG5jZitka2c3ckoyRURPU29PTU1rSy92MThBdDRUdGMK",
      "endpoints": [
        "https://github.com/nsbuitrago/rma-kinetics-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
